{
  "expo": {
    "name": "Clobit",
    "slug": "Capstone2024",
    "version": "1.0.0",
    "scheme": "clobit",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSMicrophoneUsageDescription": "이 앱은 음성 녹음을 위해 마이크 접근 권한이 필요합니다."
      }
    },
    "android": {
      "package": "com.yourcompany.capstone2024",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#ffffff"
      },
      "permissions": ["RECORD_AUDIO"],
      "config": {
        "usesCleartextTraffic": true
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "platforms": ["ios", "android", "web"],
    "plugins": [
      "expo-font",
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "fd9d78f2-cf86-4238-87f8-fbcba18bbadb"
      }
    },
    "linking": {
      "prefixes": ["clobit://"]
    },
    "owner": "eun4995"
  }
}
